# Ignore editor and IDE settings
.idea/
.vscode/
.claude/
.cache/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz
# Exception: keep the pre-built offline install bundle in-tree so users can
# clone the repo on an online machine and hand-carry it to offline servers.
!offline/*.tar.gz

# Ignore build and distribution directories
backup/
bin/
dist/
release/
node_modules/

# Ignore compiled binaries
main

# Ignore script and executable files
/release.sh
/x-ui

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
x-ui.db

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
