[Unit]
Description=x-ui Service
After=network.target
Wants=network.target
# Stop restarting after 6 failures in 5 minutes. Without a cap, a persistently
# unreachable database (or any startup failure) restarts the unit every 5s
# forever, flooding the journal and burying the real error.
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
EnvironmentFile=-/etc/sysconfig/x-ui
Environment="XRAY_VMESS_AEAD_FORCED=false"
Type=simple
WorkingDirectory=/usr/local/x-ui/
ExecStart=/usr/local/x-ui/x-ui
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
